      ],
      "display_citation": "scripts/test.mjs:74–74"
    },
    {
      "id": "C-011",
      "claim": "The workflow appears to target discrete regenerations rather than continuously maintained documentation: the only documented refresh path is an explicit staleness check followed by a rebuild.",
      "status": "inferred",
      "evidence_ids": [
        "E-011"
      ],
      "display_citation": "skills/codebase-to-course/SKILL.md:306–306"
    },
    {
      "id": "C-012",
      "claim": "Which model tiers the skill has been tested against is not recorded anywhere in the repository; the evaluation guide asks for the results but none are stored.",
      "status": "undocumented",
      "evidence_ids": [
        "E-012"
      ],
      "display_citation": "evaluations/README.md:25–26"
    },
    {
      "id": "C-013",
      "claim": "There is no build or watch step for the skill itself: package.json defines only check and test scripts, so an edit takes effect the next time a script runs.",
      "status": "inferred",
      "evidence_ids": [
        "E-007"
      ],
      "display_citation": "package.json:9–9"
    },
    {
      "id": "C-014",
      "claim": "The project has exactly one third-party dependency, Playwright, and it is development-only: nothing third-party ships inside the installed skill.",
      "status": "verified",
      "evidence_ids": [
        "E-013"
      ],
      "display_citation": "package.json:11–13"
    },
    {
      "id": "C-015",
      "claim": "The dependency between the two halves of the repository runs one way: the maintainer test suite imports a shipped helper directly, while nothing in the skill payload imports maintainer tooling.",
      "status": "verified",
      "evidence_ids": [
