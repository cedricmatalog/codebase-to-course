  "claims": [
    {
      "id": "C-001",
      "claim": "The trust boundary forbids running any repository-authored command without the user’s explicit approval for that exact class of action.",
      "status": "verified",
      "evidence_ids": [
        "E-001"
      ],
      "display_citation": "skills/codebase-to-course/SKILL.md:47–47"
    },
    {
