      "evidence_ids": [
        "E-004"
      ],
      "display_citation": "skills/codebase-to-course/references/build.mjs:414–415"
    },
    {
      "id": "C-005",
      "claim": "The shared runtime initialises each exercise inside a guard, so one broken exercise cannot disable the rest of the course.",
      "status": "verified",
      "evidence_ids": [
        "E-005"
      ],
      "display_citation": "skills/codebase-to-course/references/main.js:38–44"
    },
    {
      "id": "C-006",
      "claim": "The staleness checker exits non-zero when any cited excerpt no longer matches the repository.",
